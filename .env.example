# SupplyChain Application Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Security Settings
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict
SESSION_TIMEOUT=1800

# Core Database (User Authentication, Session Management)
DB_CORE_HOST=your-core-db-host
DB_CORE_USERNAME=your-core-db-username
DB_CORE_PASSWORD=your-core-db-password
DB_CORE_DATABASE=your-core-db-name

# Purchase Order Management Database
DB_POM_HOST=your-pom-db-host
DB_POM_USERNAME=your-pom-db-username
DB_POM_PASSWORD=your-pom-db-password
DB_POM_DATABASE=your-pom-db-name

# Inventory Management System Database
DB_IMS_HOST=your-ims-db-host
DB_IMS_USERNAME=your-ims-db-username
DB_IMS_PASSWORD=your-ims-db-password
DB_IMS_DATABASE=your-ims-db-name

# Supplier Management Database
DB_SVM_HOST=your-svm-db-host
DB_SVM_USERNAME=your-svm-db-username
DB_SVM_PASSWORD=your-svm-db-password
DB_SVM_DATABASE=your-svm-db-name

# Procurement System Management Database
DB_PSM_HOST=your-psm-db-host
DB_PSM_USERNAME=your-psm-db-username
DB_PSM_PASSWORD=your-psm-db-password
DB_PSM_DATABASE=your-psm-db-name

# Document Tracking & Records System Database
DB_DTRS_HOST=your-dtrs-db-host
DB_DTRS_USERNAME=your-dtrs-db-username
DB_DTRS_PASSWORD=your-dtrs-db-password
DB_DTRS_DATABASE=your-dtrs-db-name

# Warehouse & Stock Management Database
DB_SWS_HOST=your-sws-db-host
DB_SWS_USERNAME=your-sws-db-username
DB_SWS_PASSWORD=your-sws-db-password
DB_SWS_DATABASE=your-sws-db-name

# Legacy Default Database Fallback (DEPRECATED - Use specific DB_* variables above)
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# CSRF Protection
CSRF_TOKEN_LENGTH=32
CSRF_TOKEN_EXPIRY=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW=900
RATE_LIMIT_LOCKOUT_DURATION=1800
